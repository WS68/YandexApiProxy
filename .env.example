# Copy this file to .env and fill in real values (or export them in your shell).
# The proxy reads variables from the process environment, not from .env directly.
# If you want to use a .env file, run: node --env-file=.env src/server.js

# Yandex Cloud API key (service account key or OAuth token)
YANDEX_API_KEY=

# Yandex Cloud folder id used to build the model id:
#   emb://<YANDEX_FOLDER_ID>/text-embeddings-v2-doc/latest
YANDEX_FOLDER_ID=

# Port the proxy listens on (default: 9988)
PORT=9988

# Optional overrides:
# YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# YANDEX_CONCURRENCY=1
# YANDEX_TIMEOUT_MS=60000
#
# Upstream HTTP 429 (rate limit) responses are retried automatically with
# exponential backoff: 1s, 2s, 4s, 8s, 16s, 32s, then 60s (cap). If a retry
# following the full 60s wait still returns 429, the request fails with 429.
